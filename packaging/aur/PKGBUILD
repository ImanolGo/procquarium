# Maintainer: ImanolGo <ImanolGo@users.noreply.github.com>
pkgname=procquarium
pkgver=0.3.1
pkgrel=1
pkgdesc="Your running processes, as fish"
arch=('x86_64' 'aarch64')
url="https://github.com/ImanolGo/procquarium"
license=('MIT')
depends=('gcc-libs')
makedepends=('rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bfc500b40e188ae9d050f94257f25da324ba8586f115091676e98aec50106897')

prepare() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  cargo build --frozen --release --target "$CARCH-unknown-linux-gnu"
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  cargo test --frozen --release --target "$CARCH-unknown-linux-gnu"
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/$CARCH-unknown-linux-gnu/release/$pkgname" \
    "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 procquarium.example.toml \
    "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
}
